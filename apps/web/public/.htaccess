Options -MultiViews
RewriteEngine On

# Never rewrite compiled JavaScript or CSS assets to index.html.
RewriteRule ^assets/ - [L]

# Keep real files and directories accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send client-side application URLs to the Vite entry point.
RewriteRule ^ index.html [L]
